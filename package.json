{
  "name": "kwentohabi",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "npm run start:production",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser-check.mjs",
    "start:production": "tsx server.ts --production",
    "format": "prettier --write src server server.ts tests vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
