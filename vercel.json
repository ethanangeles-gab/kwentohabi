{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": [
        "server/document-worker.mjs",
        "node_modules/pdf-parse/**/*",
        "node_modules/mammoth/**/*"
      ]
    }
  }
}
