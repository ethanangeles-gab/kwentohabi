# Optional server-side AI credentials. Leave blank for limited local checks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Durable, single-process school storage. Never put this directory under public/.
DATA_DIR=data
MONTHLY_CHECK_LIMIT=20
PORT=3000
HOST=127.0.0.1
# Set true when serving over HTTPS.
COOKIE_SECURE=false
